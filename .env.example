# =============================================================================
# CodeMentor AI (Think_First) — Environment Variable Template
# Copy to .env (never commit real secrets or credentials)
# =============================================================================

# --- Application Environment ---
APP_ENV=development
APP_NAME="CodeMentor AI API"
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# --- Database (PostgreSQL + pgvector) ---
# Local Docker Compose default; in Phase 2+ point to local or cloud Supabase Postgres
DATABASE_URL=postgresql+asyncpg://codementor:codementor_dev@localhost:5432/codementor

# --- Frontend Public Configuration ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Supabase Authentication (Phase 2+) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Backend-only privileged key — NEVER expose to browser or NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=replace-with-backend-only-service-role-key

# --- Judge0 CE Execution Service (Phase 3+) ---
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=

# --- Configurable LLM & Embedding Providers (Phase 4+) ---
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536

# --- Monitoring (Phase 9+) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
